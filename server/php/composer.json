{
  "name": "stockflow/php-backend",
  "description": "StockFlow PHP Backend Service - PDF generation, email, webhooks, notifications",
  "type": "project",
  "require": {
    "php": ">=8.2",
    "slim/slim": "^4.12",
    "slim/psr7": "^1.6",
    "php-di/php-di": "^7.0",
    "php-di/slim-bridge": "^3.4",
    "dompdf/dompdf": "^2.0",
    "phpmailer/phpmailer": "^6.9",
    "phpoffice/phpspreadsheet": "^1.29",
    "firebase/php-jwt": "^6.10",
    "guzzlehttp/guzzle": "^7.8",
    "vlucas/phpdotenv": "^5.6"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "StockFlow\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "StockFlow\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --configuration phpunit.xml",
    "lint": "find src -name '*.php' -exec php -l {} \\;"
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "policy": {
      "advisories": {
        "block": false
      }
    }
  }
}
