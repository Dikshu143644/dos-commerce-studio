# StockFlow PHP Backend Environment Variables

# Application
APP_NAME=StockFlow
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8080

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# SMTP Email (PHPMailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_NAME=StockFlow
SMTP_FROM_EMAIL=noreply@stockflow.app

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# Shipping Webhook
SHIPPING_WEBHOOK_SECRET=your-shipping-webhook-secret

# WhatsApp / SMS (MSG91)
MSG91_AUTH_KEY=your-msg91-auth-key
MSG91_SENDER_ID=STFLOW
MSG91_TEMPLATE_ID=your-template-id

# Twilio (alternative WhatsApp/SMS)
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_NUMBER=+14155238886

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Storage
STORAGE_PATH=./storage
PDF_STORAGE_PATH=./storage/pdfs
EXPORT_STORAGE_PATH=./storage/exports

# Company Details (for PDF templates)
COMPANY_NAME=StockFlow Pvt. Ltd.
COMPANY_ADDRESS=123 Business Park, Mumbai, Maharashtra 400001
COMPANY_GST=27AAAAA0000A1Z5
COMPANY_PHONE=+91 98765 43210
COMPANY_EMAIL=accounts@stockflow.app
COMPANY_BANK_NAME=HDFC Bank
COMPANY_BANK_ACCOUNT=50100123456789
COMPANY_BANK_IFSC=HDFC0001234
COMPANY_BANK_BRANCH=Andheri West, Mumbai
